{
  "expo": {
    "name": "Atlas Learn",
    "slug": "atlas-learn-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "atlas-learn-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Nunito/static/Nunito-Regular.ttf",
            "./assets/fonts/Nunito/static/Nunito-Medium.ttf",
            "./assets/fonts/Nunito/static/Nunito-SemiBold.ttf",
            "./assets/fonts/Nunito/static/Nunito-Bold.ttf",
            "./assets/fonts/Nunito/static/Nunito-ExtraBold.ttf",
            "./assets/fonts/Nunito/static/Nunito-Black.ttf",
            "./assets/fonts/Nunito/static/Nunito-Italic.ttf",
            "./assets/fonts/Nunito/static/Nunito-MediumItalic.ttf",
            "./assets/fonts/Nunito/static/Nunito-SemiBoldItalic.ttf",
            "./assets/fonts/Nunito/static/Nunito-BoldItalic.ttf",
            "./assets/fonts/Nunito/static/Nunito-ExtraBoldItalic.ttf",
            "./assets/fonts/Nunito/static/Nunito-BlackItalic.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
